# --- Points the agent at the backend running on the SAME VM ---
# Both processes live on one Alibaba Cloud VM. They talk over localhost,
# never over the public IP — nothing about this traffic needs to leave
# the machine, so there's nothing for an outsider to intercept.
BACKEND_API_URL=http://127.0.0.1:8000

# Must be IDENTICAL to BACKEND_API_KEY in backend/.env — this is the
# static shared secret both processes are configured with, not
# something provisioned per-agent.
BACKEND_API_KEY=change-me-to-a-long-random-string

# Used by the treasury policy's x402AllowedDomains check — must match
# the host the agent is actually paying (127.0.0.1 here, since that's
# where BACKEND_API_URL points).
BACKEND_HOST=127.0.0.1

# This agent's display name (used when registering with the backend).
AUTOMATON_NAME=my-automaton

# Optional: cap on child-sandbox memory when this agent replicates.
# CHILD_SANDBOX_MEMORY_MB=1024

# --- Merged from backend/agent-runtime (see /MERGE-NOTES.md) ---
# remote-memory-client.ts and tool-registry-client.ts now read
# BACKEND_API_URL/BACKEND_API_KEY (above) via config.ts's loadConfig()
# first. BACKEND_URL/BACKEND_API_KEY below are only a fallback for
# running those modules outside a loaded automaton config.
# BACKEND_URL=http://127.0.0.1:8000
# BACKEND_API_KEY=change-me-to-a-long-random-string
# MAX_WORKING_MESSAGES=30
# KEEP_RECENT_MESSAGES=10

# Opt-in: runs remote-compaction.ts as a heartbeat task, summarizing
# working memory via a real inference call and persisting it to the
# backend's /memory/episodic endpoint. Off by default — local SQLite
# memory (episodic.ts/semantic.ts/etc.) is unaffected either way.
# REMOTE_MEMORY_SYNC_ENABLED=true

# Department Agent / Worker scoping (see policy-rules/department-scope.ts).
# Unset (default) = unrestricted top-level Agent, same as before this
# existed. Set by the backend when it spawns a department worker's
# process/container.
# AGENT_TIER=department_agent   # or "worker" (or "agent" for explicit top-level)
# DEPARTMENT_ROLE=Software      # matched against department-profiles.ts
# WORKER_ROLE=backend worker    # only meaningful when AGENT_TIER=worker

# --- Infra-Ops: Alibaba Cloud VM self-management (optional) ---
# When set, the agent runs infra_renewal_check and infra_capacity_check
# heartbeat tasks to keep its own VM alive and sized correctly.
# Use a RAM sub-account key (not root) scoped to the minimal ECS/BSS
# actions listed in agent/src/infra/README.md.
#
# ALIBABA_ACCESS_KEY_ID=...
# ALIBABA_ACCESS_KEY_SECRET=...
# ALIBABA_REGION_ID=cn-hangzhou
# ALIBABA_INSTANCE_ID=i-xxxxxxxx
# ALIBABA_DISK_ID=d-xxxxxxxx      # optional; capacity check degrades gracefully if absent
# ALIBABA_WALLET_ADDRESS=0x...    # EVM wallet you control that Alibaba credits after you deposit
# ALIBABA_USDC_NETWORK=base       # or base-sepolia for testnet; defaults to base
# Agent-local self-mod lifecycle (never point these at the general backend)
AGENT_DEPARTMENT_DRAIN_COMMAND=""
AGENT_DRAIN_TIMEOUT_MS=300000
AGENT_RESTART_COMMAND=""
AGENT_RESTART_DELAY_MS=1000
